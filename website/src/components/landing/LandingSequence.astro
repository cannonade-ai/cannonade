---
interface Step {
  title: string
  body: string
}

const steps: Step[] = [
  {
    title: 'Add a provider',
    body: 'Point Cannonade at a local server or a cloud gateway.'
  },
  {
    title: 'Write the cases',
    body: 'A case is an input, an optional system prompt, and the evaluators that score the answer.'
  },
  {
    title: 'Start a run',
    body: 'Pick as many models as you want.'
  },
  {
    title: 'Check the result',
    body: 'See what each model answered, what it scored, and how fast it was.'
  }
]
---

<section class="section" id="how">
  <div class="wrap">
    <div class="section__head">
      <p class="section-label">How it works</p>
      <h2 class="section-title">What a run looks like</h2>
    </div>
    <div class="seq">
      {
        steps.map((step) => (
          <article class="seq__step">
            <h3 class="seq__t">{step.title}</h3>
            <p>{step.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
