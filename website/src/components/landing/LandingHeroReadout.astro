---
interface Row {
  model: string;
  kind: string;
  passed: number;
  total: number;
  score: number;
  rate: string;
}

const rows: Row[] = [
  { model: 'qwen3-14b', kind: 'local', passed: 12, total: 12, score: 0.96, rate: '41.8' },
  { model: 'gpt-oss-20b', kind: 'cloud', passed: 12, total: 12, score: 0.94, rate: '130.7' },
  { model: 'llama3.1-8b', kind: 'local', passed: 11, total: 12, score: 0.89, rate: '72.4' },
  { model: 'gemma3-12b', kind: 'local', passed: 10, total: 12, score: 0.84, rate: '48.6' },
  { model: 'mistral-7b', kind: 'local', passed: 8, total: 12, score: 0.71, rate: '88.3' },
  { model: 'phi-4-mini', kind: 'local', passed: 6, total: 12, score: 0.58, rate: '104.2' }
];

function passColor(row: Row): string {
  if (row.passed === row.total) return 'var(--cn-pass)';
  if (row.passed / row.total < 0.6) return 'var(--cn-fail)';
  return 'var(--cn-text-2)';
}
---

<div class="readout">
  <div class="readout__bar">
    <span class="readout__dot" aria-hidden="true"></span>
    <span>Run complete</span>
    <span class="readout__suite">refund-policy-v3</span>
  </div>
  <div class="readout__scroll">
    <table class="readout__table">
      <caption class="sr-only">Sample test run: six models scored against the same twelve cases</caption
      >
      <thead>
        <tr>
          <th scope="col" class="readout__model">Model</th>
          <th scope="col">Pass</th>
          <th scope="col">Mean score</th>
          <th scope="col">Tok/s</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row, i) => (
            <tr>
              <td class="readout__model">
                {row.model}
                <span class="readout__tag">{row.kind}</span>
              </td>
              <td style={`color:${passColor(row)}`}>
                {row.passed}/{row.total}
              </td>
              <td>
                <span class="readout__score">
                  <span class="readout__track">
                    <span
                      class="readout__fill"
                      style={`--w:${row.score};--d:${0.15 + i * 0.09}s`}
                    />
                  </span>
                  <span class="readout__num">{row.score.toFixed(2)}</span>
                </span>
              </td>
              <td>{row.rate}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <div class="readout__foot">
    <span>12 cases</span>
    <span>6 models</span>
    <span>evaluators <b>contains · rouge · llm_rubric</b></span>
    <span>elapsed <b>2m 41s</b></span>
  </div>
</div>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
