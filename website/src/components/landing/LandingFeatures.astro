---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import playgroundImg from '../../assets/playground.png'
import runResultsImg from '../../assets/run-results.png'
import modelsImg from '../../assets/models.png'
import promptsImg from '../../assets/prompts.png'

interface Feature {
  title: string
  body: string
  points: string[]
  shot: ImageMetadata
  alt: string
}

const features: Feature[] = [
  {
    title: 'Run results',
    body: 'Results arrive while the run is still going, and stay on disk once it finishes.',
    points: ['Pass rate and score per model', 'Tokens, speed, and cost'],
    shot: runResultsImg,
    alt: 'A finished test case in a run: system prompt, model output, evaluator score, and token stats'
  },
  {
    title: 'Playground',
    body: 'A chat view for trying a model before writing cases for it.',
    points: ['Any configured model', 'Sampling parameters per message', 'Stats on every response'],
    shot: playgroundImg,
    alt: 'The playground chat view with a local model selected and response stats above the reply'
  },
  {
    title: 'Prompt library',
    body: 'System prompts live in one place, so one edit reaches every case using them.',
    points: ['Shared by suites and the playground', 'Versioned'],
    shot: promptsImg,
    alt: 'The prompt library listing shared system prompts'
  },
  {
    title: 'Model management',
    body: 'Handle local models without switching to another app.',
    points: ['Load, unload or delete them'],
    shot: modelsImg,
    alt: 'The models view listing downloaded local models'
  }
]

const shotSizes = '(min-width: 1256px) 510px, (min-width: 900px) 48vw, calc(100vw - 66px)'

const shotWidths = (shot: ImageMetadata): number[] =>
  [520, 1020].filter((width) => width < shot.width).concat(shot.width)
---

<section class="section" id="features">
  <div class="wrap">
    <div class="section__head">
      <p class="section-label">Features</p>
      <h2 class="section-title">What is in the app</h2>
    </div>
    <div class="features">
      {
        features.map((feature, i) => (
          <article class={i % 2 === 1 ? 'feature feature--flip' : 'feature'}>
            <div class="feature__body">
              <h3 class="feature__t">{feature.title}</h3>
              <p>{feature.body}</p>
              <ul class="feature__list">
                {feature.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </div>
            <div class="feature__shot">
              <Image
                src={feature.shot}
                alt={feature.alt}
                loading="lazy"
                quality={90}
                widths={shotWidths(feature.shot)}
                sizes={shotSizes}
              />
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
