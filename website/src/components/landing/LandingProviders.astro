---
interface Provider {
  name: string;
  kind: string;
  body: string;
}

const providers: Provider[] = [
  {
    name: 'Ollama',
    kind: 'Local',
    body: 'Local or remote Ollama server, with model load, unload, delete, and download from inside the app.'
  },
  {
    name: 'LM Studio',
    kind: 'Local',
    body: 'Local or remote LM Studio server, using its native API for complete token and timing statistics.'
  },
  {
    name: 'OpenRouter',
    kind: 'Cloud',
    body: 'Hundreds of cloud models behind one API key, with pricing and context length listed per model.'
  },
  {
    name: 'Custom',
    kind: 'Either',
    body: 'Any OpenAI-compatible endpoint: vLLM, a llama.cpp server, a gateway, or a provider not yet supported natively.'
  }
];
---

<section class="section" id="providers">
  <div class="wrap">
    <div class="section__head">
      <p class="eyebrow">Providers</p>
      <h2 class="section-title">Bring the models you already run</h2>
      <p class="lede">
        Add as many providers as you like. A single run can mix them freely — that comparison is
        usually the reason to run one. More native providers are in progress; see the <a
          href="/docs/guides/connect-a-provider/">provider guide</a
        >.
      </p>
    </div>
    <div class="providers">
      {
        providers.map((provider) => (
          <article class="provider">
            <span class="provider__k">{provider.kind}</span>
            <span class="provider__n">{provider.name}</span>
            <p>{provider.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
