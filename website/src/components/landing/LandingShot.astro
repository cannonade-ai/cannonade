---
const src = 'https://placehold.co/1680x914/151a20/e6a817.png?text=Test+run+details'
const alt = 'Screenshot placeholder: the test run details view'
---

<section class="shot">
  <div class="shot__glow" aria-hidden="true"></div>
  <div class="wrap shot__wrap">
    <figure class="shot__frame">
      <img class="shot__img" src={src} alt={alt} width="1680" height="914" loading="eager" />
    </figure>
  </div>
</section>
