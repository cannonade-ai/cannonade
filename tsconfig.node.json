{
  "extends": "./tsconfig.base.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/core/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "types": [
      "electron-vite/node"
    ],
    "paths": {
      "@main/*": [
        "./src/main/*"
      ],
      "@shared/*": [
        "./src/shared/*"
      ]
    }
  }
}